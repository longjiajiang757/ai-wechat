<?xml version="1.0" encoding="utf-8"?>
<!--
  启动窗口背景：先垫一层平均色，再把整张图按原比例居中放上去。
  注意 layer-list 里的 bitmap 只认 gravity 的对齐值（center/fill/...），
  写 centerCrop 会直接链接失败。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FF736267" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_bg" />
    </item>
</layer-list>
