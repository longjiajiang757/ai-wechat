<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    Android 12+ 走系统 SplashScreen：由系统画图标 + 背景色。
    图标用项目自己的启动图，背景取图片平均色，衔接不突兀。
  -->
  <style name="Theme.Rikkahub" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@drawable/splash_window_bg</item>
    <item name="android:windowSplashScreenBackground">#FF736267</item>
    <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    <item name="android:windowSplashScreenAnimationDuration">400</item>
  </style>
</resources>
